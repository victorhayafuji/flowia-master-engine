# =============================================================================
# Flowia Master Engine — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# =============================================================================

# --- Product line (salon | clinic) ---
PRODUCT_LINE=salon

# --- Google AI (required) ---
GOOGLE_API_KEY=your_google_api_key
MODEL_NAME=gemini-2.5-flash
EMBEDDING_MODEL_NAME=gemini-embedding-2

# --- Supabase (required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE=your_supabase_service_role_key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- WhatsApp / Meta (required) ---
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_APP_SECRET=

# --- Dashboard Security (required) ---
DASHBOARD_API_KEY=your_dashboard_api_key
DASHBOARD_JWT_SECRET=your_jwt_secret_min_32_chars

# --- CORS & Hosts (produção Render) ---
# ALLOWED_ORIGINS=["https://flowia-dashboard.onrender.com"]
# ALLOWED_HOSTS=["flowia-api.onrender.com"]

# --- LangSmith Observability (optional) ---
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_PROJECT=flowia-master-engine
# LANGCHAIN_API_KEY=

# --- LangGraph checkpointer (optional) ---
# auto = PostgreSQL via SUPABASE_DB_URL, fallback MemorySaver | postgres | memory
# CHECKPOINTER_BACKEND=auto

# --- Scheduling hybrid agent (optional) ---
# SCHEDULING_DETERMINISTIC_ENABLED=true
# SCHEDULING_LLM_FALLBACK=smart
# INTENT_EXTRACTOR_ENABLED=true
# RESPONSE_POLISH_ENABLED=false

# --- WhatsApp simulation (scripts/simulate_whatsapp_webhook.py — dev only) ---
# SIM_WHATSAPP_ORG_ID=22222222-2222-2222-2222-222222222222
# SIM_WHATSAPP_PHONE_ID=123456789

# --- Background scheduler (optional) ---
# Reminders + no-show detection. Disable in tests/CI with false.
# SCHEDULER_ENABLED=true
# Retention for webhook_message_dedup purge (daily job when scheduler enabled)
# WEBHOOK_DEDUP_RETENTION_DAYS=7
# SLACK_WEBHOOK_URL=
# FALLBACK_USD_TO_BRL=5.30
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# COOKIE_SECURE=false

# --- Frontend (Vite — prefix VITE_) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your_supabase_anon_key
VITE_API_URL=http://localhost:8000/api/v1

# --- Dev-only (local development — NEVER set in production) ---
# Run: python scripts/setup_dev_env.py --email admin@salao.com --password YOUR_PASSWORD
DEV_ADMIN_EMAIL=admin@salao.com
DEV_ADMIN_PASSWORD=your_dev_password
DEV_ADMIN_ORG_ID=22222222-2222-2222-2222-222222222222
VITE_DEV_EMAIL=admin@flowia.com
VITE_DEV_PASSWORD=your_dev_password

# Login de teste como dono do salão (org_admin — RLS só do salão)
# Run: python scripts/create_salon_user.py --email dono@beauty-express.com --password YOUR_PASSWORD
DEV_SALON_EMAIL=dono@beauty-express.com
DEV_SALON_PASSWORD=your_salon_password
DEV_SALON_ORG_ID=22222222-2222-2222-2222-222222222222
VITE_DEV_SALON_EMAIL=dono@beauty-express.com
VITE_DEV_SALON_PASSWORD=your_salon_password
