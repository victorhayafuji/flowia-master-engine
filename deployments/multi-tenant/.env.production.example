# FlowIA multi-tenant — produção (Render Web Service)
# Copie valores para Render Dashboard → flowia-api → Environment
# NUNCA commitar .env com secrets reais

PRODUCT_LINE=salon
CHECKPOINTER_BACKEND=auto
SCHEDULER_ENABLED=true
COOKIE_SECURE=true
WEBHOOK_DEDUP_RETENTION_DAYS=7

# Gerar novos: python scripts/generate_prod_secrets.py
GOOGLE_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE=
SUPABASE_DB_URL=
WHATSAPP_VERIFY_TOKEN=
DASHBOARD_API_KEY=
DASHBOARD_JWT_SECRET=

# Após deploy do Static Site — URL exata HTTPS, sem barra final
ALLOWED_ORIGINS=["https://flowia-dashboard.onrender.com"]
# Hostname da API Render (+ custom domain se houver)
ALLOWED_HOSTS=["flowia-api.onrender.com"]

# --- NÃO definir em produção ---
# DEV_* , VITE_DEV_*
